# LumièreAI India — Environment Variables Template
# Copy this file to `.env` and populate with your actual credentials.
# NEVER commit `.env` containing real API keys to version control.

# OpenAI API (Embeddings: text-embedding-3-small | LLM: gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API (Embeddings: embed-english-v3.0 | Rerank: rerank-english-v3.0 | LLM: command-r-plus-08-2024)
COHERE_API_KEY=your_cohere_api_key_here

# Google Gemini API (Embeddings: models/text-embedding-004 | LLM: gemini-1.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA NIM API (Prioritized Cross-Encoder Reranking: nvidia/reranking-nv-embed-qa-4)
NVIDIA_API_KEY=your_nvidia_api_key_here

# LlamaCloud API (Optional — for LlamaParse complex table extraction)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key_here

# Neo4j Database (Stage 3 Knowledge Graph RAG)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Supabase (PostgreSQL Persistence for chat_sessions, chat_messages, documents + Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_publishable_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key_here

# Application Settings
DEBUG=True
ENVIRONMENT=development
PORT=8000

# Active Embedding & Synthesis Provider: openai, cohere, or gemini
EMBEDDING_PROVIDER=cohere
