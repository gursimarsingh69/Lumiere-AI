# LegalMind India Environment Variables Example

# OpenAI API (For Embeddings and LLM)
OPENAI_API_KEY=your_openai_api_key_here

# Cohere API (For Reranking - Alternative)
COHERE_API_KEY=your_cohere_api_key_here

# Gemini API (For Embeddings and LLM)
GEMINI_API_KEY=your_gemini_api_key_here

# NVIDIA API (For Nemotron Reranking - Prioritized)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Neo4j Database (For Knowledge Graph - Stage 3)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# Application Settings
DEBUG=True
ENVIRONMENT=development

# Active Embedding Provider: openai, cohere, or gemini
EMBEDDING_PROVIDER=openai
